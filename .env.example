# ==============================================================================
# IT Assistant - ตัวอย่างการกำหนดค่าสภาพแวดล้อม (Environment Variables Example)
# ==============================================================================
# สำหรับการใช้งาน ให้คัดลอกไฟล์นี้เป็น .env แล้วกรอกข้อมูลจริง:
#   Linux / macOS: cp .env.example .env
#   Windows CMD:   copy .env.example .env
#   PowerShell:    Copy-Item .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Configuration (จำเป็น - Required)
# ------------------------------------------------------------------------------
# ดูข้อมูลการตั้งค่าได้จาก:
#   Firebase Console -> Project Settings -> General -> Your apps -> Web app
#   เปิดใช้งาน Firebase Authentication และ Realtime Database ให้เรียบร้อย

# Web API Key สำหรับเรียกใช้งาน Firebase API
VITE_FIREBASE_API_KEY=your_firebase_api_key

# โดเมนสำหรับการยืนยันตัวตน (Firebase Authentication) เช่น your-project-id.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# URL ฐานข้อมูล Firebase Realtime Database
# เช่น https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app/
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app/

# รหัสระบุโปรเจกต์ของ Firebase (Project ID)
VITE_FIREBASE_PROJECT_ID=your_project_id

# พื้นที่จัดเก็บไฟล์ Cloud Storage Bucket เช่น your-project-id.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Messaging Sender ID สำหรับ Cloud Messaging
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Web Application ID ใน Firebase Project
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------------------------------------------
# 2. Application Environment (จำเป็น - Required)
# ------------------------------------------------------------------------------
# โหมดการทำงานของระบบ (development / production / test)
VITE_NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. n8n AI Workflow Integration
# ------------------------------------------------------------------------------
# [จำเป็น - Required] Webhook URL สำหรับรับ-ส่งข้อความกับระบบแชทบอท AI
# ดูขั้นตอนการติดตั้งและตั้งค่าได้ที่เอกสาร: N8N_PREREQUISITES_GUIDE.md
# ตัวอย่าง Local development: http://localhost:5678/webhook/<webhook-uuid>/chat
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/your_chat_webhook_uuid/chat

# [ทางเลือก - Optional] Webhook URL สำหรับสรุปประวัติหรือข้อมูลการเรียน
VITE_N8N_SUMMARY_WEBHOOK_URL=http://localhost:5678/webhook/your_summary_webhook_uuid/summary
