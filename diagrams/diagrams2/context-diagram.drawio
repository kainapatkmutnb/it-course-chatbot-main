<mxfile host="app.diagrams.net" modified="2026-09-15T00:00:00.000Z" agent="Mozilla/5.0" version="24.0.0" type="device">
  <diagram id="ContextDiagram" name="System Context Diagram">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Header -->
        <mxCell id="header" value="&lt;b style='font-size: 22px;'&gt;🎓 IT Assistant — System Context Diagram (C4 Context Model)&lt;/b&gt;&lt;br/&gt;&lt;span style='color: #475569; font-size: 13px;'&gt;ภาควิชาเทคโนโลยีสารสนเทศ · คณะเทคโนโลยีและการจัดการอุตสาหกรรม · มหาวิทยาลัยเทคโนโลยีพระจอมเกล้าพระนครเหนือ (KMUTNB)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="30" width="1400" height="60" as="geometry" />
        </mxCell>

        <!-- Tier 1: Stakeholders -->
        <mxCell id="t1_box" value="👥 ผู้ใช้งานระบบ (Stakeholders)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;fontStyle=1;fontSize=15;fontColor=#0369A1;startSize=36;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="340" height="680" as="geometry" />
        </mxCell>
        <mxCell id="act_student" value="&lt;b style='font-size:14px;color:#0C4A6E;'&gt;🎓 นักศึกษา (Students)&lt;/b&gt;&lt;hr/&gt;• วางแผนการเรียน 4 ปี (Study Plan)&lt;br/&gt;• ตรวจสอบความก้าวหน้า &amp; เกรด&lt;br/&gt;• ดูผังหลักสูตรปกติ / สหกิจ (มคอ.2)&lt;br/&gt;• ปรึกษาแชทบอทหลักสูตรอัจฉริยะ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="t1_box">
          <mxGeometry x="20" y="55" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="act_instructor" value="&lt;b style='font-size:14px;color:#0C4A6E;'&gt;👨‍🏫 อาจารย์ที่ปรึกษา (Instructors)&lt;/b&gt;&lt;hr/&gt;• ติดตามแผนการเรียนนักศึกษาในความดูแล&lt;br/&gt;• ตรวจสอบผลการเรียนและวิทยาทัณฑ์&lt;br/&gt;• ให้คำปรึกษาและข้อเสนอแนะการลงทะเบียน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="t1_box">
          <mxGeometry x="20" y="210" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="act_staff" value="&lt;b style='font-size:14px;color:#0C4A6E;'&gt;🏢 บุคลากร / เจ้าหน้าที่ (Staff)&lt;/b&gt;&lt;hr/&gt;• บริหารจัดการรายวิชาและหลักสูตร 13 ฉบับ&lt;br/&gt;• ซิงค์และทำความสะอาดข้อมูลหลักสูตร&lt;br/&gt;• กำหนดเงื่อนไขรายวิชาต่อเนื่อง (Prereq)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="t1_box">
          <mxGeometry x="20" y="365" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="act_admin" value="&lt;b style='font-size:14px;color:#0C4A6E;'&gt;⚙️ ผู้ดูแลระบบ (Admins)&lt;/b&gt;&lt;hr/&gt;• จัดการบัญชีผู้ใช้และกำหนดสิทธิ์ (RBAC)&lt;br/&gt;• ตรวจสอบสถิติการใช้งาน &amp; Chat Analytics&lt;br/&gt;• ดูผลประเมินความพึงพอใจและ Audit Logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="t1_box">
          <mxGeometry x="20" y="520" width="300" height="130" as="geometry" />
        </mxCell>

        <!-- Tier 2: Core System -->
        <mxCell id="t2_box" value="💻 ระบบหลัก (Core Application Platform)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;strokeWidth=2.5;fontStyle=1;fontSize=15;fontColor=#0F172A;startSize=36;" vertex="1" parent="1">
          <mxGeometry x="500" y="120" width="600" height="680" as="geometry" />
        </mxCell>
        <mxCell id="core_app" value="&lt;div align='center'&gt;&lt;b style='font-size: 18px; color: #0F172A;'&gt;🌐 IT Assistant Web Platform&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px; color:#475569;'&gt;(React 18 · TypeScript 5.8 · Vite 5.4 · Tailwind CSS 3.4)&lt;/span&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style='line-height: 1.6; padding: 4px;'&gt;&lt;b style='color:#0369A1;'&gt;📊 Dual-View Progress System (ระบบแสดงผล 2 มุมมอง)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;📋 แผนของฉัน (StudentPlanTimeline):&lt;/b&gt; แสดงผลตามรายวิชาและเกรดที่นักศึกษาบันทึกจริง&lt;br/&gt;• &lt;b&gt;🗺️ โครงสร้างหลักสูตร (StudyPlanProgress):&lt;/b&gt; ตรวจจับแผนปกติ (หน้า 114) vs แผนสหกิจ (หน้า 115) อัตโนมัติ พร้อมเส้นลูกศร 14 เส้นและไฮไลท์สีเขียว&lt;br/&gt;&lt;br/&gt;&lt;b style='color:#0369A1;'&gt;🎯 13-Curricula Academic Engine (ระบบคำนวณและกฎหลักสูตร)&lt;/b&gt;&lt;br/&gt;• ครอบคลุม 5 สาขาวิชา (IT, INE, INET, ITI, ITT) ทุกรอบปี พ.ศ. (62, 64, 67)&lt;br/&gt;• คำนวณหน่วยกิตรวม (120-135 หน่วยกิต) และเกณฑ์วิทยาทัณฑ์ (Academic Standing)&lt;br/&gt;• เครื่องมือแปลงรหัสวิชาดอกจัน (*), ตรวจสอบ Prerequisite และ Cascade Clear&lt;br/&gt;&lt;br/&gt;&lt;b style='color:#0369A1;'&gt;💬 Modern Academic Chat Surface (ระบบแชทบอทอัจฉริยะ)&lt;/b&gt;&lt;br/&gt;• อินเทอร์เฟซ #n8n-chat ปรับแต่งพิเศษ รองรับ Markdown, ลิงก์ และ Feedback Banner&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="t2_box">
          <mxGeometry x="25" y="55" width="550" height="595" as="geometry" />
        </mxCell>

        <!-- Tier 3: External Services -->
        <mxCell id="t3_box" value="☁️ บริการภายนอก (External Cloud &amp; AI Services)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=15;fontColor=#B45309;startSize=36;" vertex="1" parent="1">
          <mxGeometry x="1160" y="120" width="340" height="680" as="geometry" />
        </mxCell>
        <mxCell id="ext_firebase" value="&lt;b style='font-size:15px;color:#9A3412;'&gt;🔥 Firebase Cloud Infrastructure&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;• Firebase Authentication:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;จัดการ Token, ยืนยันตัวตน และสิทธิ์ RBAC&lt;br/&gt;&lt;b&gt;• Cloud Firestore / RTDB:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;- &lt;code&gt;users/&lt;/code&gt; (โปรไฟล์ผู้ใช้และบทบาท)&lt;br/&gt;&amp;nbsp;&amp;nbsp;- &lt;code&gt;studyPlans/&lt;/code&gt; (แผนการเรียน 4 ปีและเกรด)&lt;br/&gt;&amp;nbsp;&amp;nbsp;- &lt;code&gt;courses/ &amp; curriculum/&lt;/code&gt; (ข้อมูลรายวิชา)&lt;br/&gt;&amp;nbsp;&amp;nbsp;- &lt;code&gt;chat_analytics/&lt;/code&gt; (สถิติและ Feedback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="t3_box">
          <mxGeometry x="20" y="55" width="300" height="280" as="geometry" />
        </mxCell>
        <mxCell id="ext_n8n" value="&lt;b style='font-size:15px;color:#9A3412;'&gt;🤖 n8n AI &amp; RAG Orchestrator&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;• Pinecone Vector Database:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;ค้นหาเวกเตอร์ มคอ.2 ฉบับเต็ม (62.pdf / 67.pdf)&lt;br/&gt;&amp;nbsp;&amp;nbsp;พร้อมระบุหน้าที่อ้างอิงชัดเจน&lt;br/&gt;&lt;b&gt;• OpenAI GPT-5 nano Reasoning:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;ประมวลผลคำตอบหลักสูตรที่แม่นยำ&lt;br/&gt;&amp;nbsp;&amp;nbsp;Zero-Hallucination Guardrails&lt;br/&gt;&lt;b&gt;• Webhook Endpoint:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;ส่งต่อข้อความสนทนาและรับผลลัพธ์ Realtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="t3_box">
          <mxGeometry x="20" y="370" width="300" height="280" as="geometry" />
        </mxCell>

        <!-- Connections -->
        <mxCell id="e1" value="ใช้งาน / วางแผน / ถามบอท" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.2;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#0284C7;fontColor=#0369A1;fontSize=11;" edge="1" parent="1" source="act_student" target="core_app">
