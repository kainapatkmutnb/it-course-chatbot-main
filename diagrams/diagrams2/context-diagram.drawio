        <mxCell id="e3" value="จัดการหลักสูตร / ซิงค์ข้อมูล" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.7;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#0284C7;fontColor=#0369A1;fontSize=11;" edge="1" parent="1" source="act_staff" target="core_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="จัดการผู้ใช้ / ดู Analytics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.9;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#0284C7;fontColor=#0369A1;fontSize=11;" edge="1" parent="1" source="act_admin" target="core_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="Auth Token &amp; Sync Data (CRUD)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2.5;strokeColor=#D97706;fontColor=#B45309;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;" edge="1" parent="1" source="core_app" target="ext_firebase">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="RAG Query Prompt &amp; AI Response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2.5;strokeColor=#D97706;fontColor=#B45309;fontSize=11;exitX=1;exitY=0.8;exitDx=0;exitDy=0;" edge="1" parent="1" source="core_app" target="ext_n8n">
