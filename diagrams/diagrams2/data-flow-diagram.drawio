        <!-- Processes -->
        <mxCell id="p1" value="&lt;b style='font-size:14px;'&gt;1.0 การยืนยันตัวตนและจัดการสิทธิ์&lt;/b&gt;&lt;br/&gt;(Authentication &amp; RBAC Control)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#581C87;strokeColor=#C084FC;strokeWidth=2;fontColor=#FAF5FF;" vertex="1" parent="1">
