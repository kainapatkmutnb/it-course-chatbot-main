        <!-- Header -->
        <mxCell id="header" value="&lt;b style='font-size: 22px;'&gt;🔄 IT Assistant — Data Flow Diagram (DFD Level 1)&lt;/b&gt;&lt;br/&gt;&lt;span style='color: #475569; font-size: 13px;'&gt;ผังแสดงการไหลของข้อมูล กระบวนการประมวลผล (Processes 1.0 – 5.0) และแหล่งจัดเก็บข้อมูล (Data Stores D1 – D5)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="1440" height="60" as="geometry" />
        </mxCell>

        <!-- External Entities -->
        <mxCell id="ent_user" value="&lt;b style='font-size:15px;'&gt;👤 ผู้ใช้งาน (User)&lt;/b&gt;&lt;br/&gt;Student / Instructor / Staff / Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0C4A6E;strokeColor=#38BDF8;strokeWidth=2;fontColor=#F0F9FF;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ent_auth" value="&lt;b style='font-size:15px;'&gt;🔥 Firebase Auth&lt;/b&gt;&lt;br/&gt;Identity Provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350F;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FEF3C7;" vertex="1" parent="1">
